<Window x:Class="RetroGameCoverDownloader.Views.ProxySettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proxy Settings" Height="420" Width="520" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Title -->
            <TextBlock Text="Proxy Configuration" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
            
            <!-- Explanation -->
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,15">
                If you're unable to connect to GitHub due to network restrictions (e.g., in China), 
                you can configure a proxy server to bypass these limitations.
            </TextBlock>
            
            <!-- Enable Proxy -->
            <CheckBox x:Name="UseProxyCheckBox" Content="Enable Proxy" Margin="0,0,0,15" 
                      Checked="UseProxyCheckBox_Changed" Unchecked="UseProxyCheckBox_Changed"/>
            
            <!-- Proxy Settings Group -->
            <StackPanel x:Name="ProxySettingsPanel" IsEnabled="False">
                <!-- Proxy Host -->
                <TextBlock Text="Proxy Host:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="ProxyHostBox" Height="30" Margin="0,0,0,10" 
                         ToolTip="Enter the proxy server address (e.g., 127.0.0.1 or proxy.example.com)"/>
                
                <!-- Proxy Port -->
                <TextBlock Text="Proxy Port:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="ProxyPortBox" Height="30" Margin="0,0,0,10" 
                         ToolTip="Enter the proxy port (e.g., 1080, 8080)"/>
                
                <!-- Authentication -->
                <TextBlock Text="Authentication (optional:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="Leave empty if proxy doesn't require credentials)" 
                           Foreground="Gray" FontStyle="Italic" FontSize="11" Margin="0,0,0,10"/>
                
                <!-- Username -->
                <TextBlock Text="Username:" Margin="0,0,0,5"/>
                <TextBox x:Name="ProxyUsernameBox" Height="30" Margin="0,0,0,10"/>
                
                <!-- Password -->
                <TextBlock Text="Password:" Margin="0,0,0,5"/>
                <PasswordBox x:Name="ProxyPasswordBox" Height="30" Margin="0,0,0,15"/>
            </StackPanel>
            
            <!-- Note -->
            <TextBlock Text="Note: After saving, you may need to restart the application for proxy settings to take effect." 
                       Foreground="Gray" FontStyle="Italic" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15"/>
            
            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="CancelButton_Click" Width="80" Height="30" Margin="0,0,10,0"/>
                <Button Content="Save" Click="SaveButton_Click" Width="80" Height="30" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
