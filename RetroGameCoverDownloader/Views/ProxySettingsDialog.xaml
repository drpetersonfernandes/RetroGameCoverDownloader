<Window x:Class="RetroGameCoverDownloader.Views.ProxySettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proxy Settings" Height="420" Width="520" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ToolTip="Configure proxy server settings for network-restricted environments">
    <ScrollViewer VerticalScrollBarVisibility="Auto" ToolTip="Scroll to see all proxy configuration options">
        <StackPanel Margin="20" ToolTip="Proxy configuration form">
            <!-- Title -->
            <TextBlock Text="Proxy Configuration" Style="{StaticResource TitleTextStyle}"
                       ToolTip="Proxy server configuration for bypassing network restrictions"/>
            
            <!-- Explanation -->
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,15"
                       ToolTip="Configure a proxy if you cannot connect to GitHub directly">
                If you're unable to connect to GitHub due to network restrictions (e.g., in China), 
                you can configure a proxy server to bypass these limitations.
            </TextBlock>
            
            <!-- Enable Proxy -->
            <CheckBox x:Name="UseProxyCheckBox" Content="Enable Proxy" Margin="0,0,0,15" 
                      Checked="UseProxyCheckBox_Changed" Unchecked="UseProxyCheckBox_Changed"
                      ToolTip="Toggle to enable or disable proxy server usage"/>
            
            <!-- Proxy Settings Group -->
            <StackPanel x:Name="ProxySettingsPanel" IsEnabled="False"
                        ToolTip="Proxy server configuration fields (enabled when checkbox is checked)">
                <!-- Proxy Host -->
                <TextBlock Text="Proxy Host:" Style="{StaticResource FieldLabelStyle}"
                           ToolTip="The hostname or IP address of the proxy server"/>
                <TextBox x:Name="ProxyHostBox" Style="{StaticResource TextInputStyle}"
                         ToolTip="Enter the proxy server address (e.g., 127.0.0.1 or proxy.example.com)"/>
                
                <!-- Proxy Port -->
                <TextBlock Text="Proxy Port:" Style="{StaticResource FieldLabelStyle}"
                           ToolTip="The network port the proxy server listens on"/>
                <TextBox x:Name="ProxyPortBox" Style="{StaticResource TextInputStyle}"
                         ToolTip="Enter the proxy port (e.g., 1080, 8080)"/>
                
                <!-- Authentication -->
                <TextBlock Text="Authentication (optional):" Style="{StaticResource FieldLabelStyle}"
                           ToolTip="Optional credentials for authenticated proxy servers"/>
                <TextBlock Text="Leave empty if proxy doesn't require credentials)" 
                           Style="{StaticResource NoteTextStyle}"
                           ToolTip="Only fill in username and password if your proxy requires authentication"/>
                
                <!-- Username -->
                <TextBlock Text="Username:" Margin="0,0,0,5"
                           ToolTip="Proxy authentication username"/>
                <TextBox x:Name="ProxyUsernameBox" Style="{StaticResource TextInputStyle}"
                         ToolTip="Enter your proxy username (leave empty if no authentication required)"/>
                
                <!-- Password -->
                <TextBlock Text="Password:" Margin="0,0,0,5"
                           ToolTip="Proxy authentication password"/>
                <PasswordBox x:Name="ProxyPasswordBox" Style="{StaticResource PasswordInputStyle}"
                             ToolTip="Enter your proxy password (leave empty if no authentication required)"/>
            </StackPanel>
            
            <!-- Note -->
            <TextBlock Text="Proxy settings will be applied immediately after saving." 
                       Style="{StaticResource NoteTextStyle}"
                       ToolTip="Your proxy settings will take effect as soon as you click Save"/>
            
            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" ToolTip="Dialog action buttons">
                <Button Content="Cancel" Click="CancelButton_Click" Style="{StaticResource DialogButtonStyle}"
                        ToolTip="Discard proxy changes and close this dialog"/>
                <Button Content="Save" Click="SaveButton_Click" Style="{StaticResource DialogButtonStyle}"
                        IsDefault="True" Margin="0"
                        ToolTip="Save proxy configuration and apply changes"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
