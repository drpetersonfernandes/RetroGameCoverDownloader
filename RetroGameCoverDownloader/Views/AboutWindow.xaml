<Window x:Class="RetroGameCoverDownloader.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Retro Game Cover Downloader"
        Width="460"
        Height="495"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10" HorizontalAlignment="Center" Orientation="Horizontal">
            <Image Width="128" Height="128" Source="pack://application:,,,/icon/icon.ico" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock FontWeight="Bold" FontSize="18" Text="Retro Game Cover Downloader" />
            <TextBlock x:Name="DescriptionTextBlock" TextWrapping="Wrap" Text="A utility for downloading game cover art from libretro-thumbnails GitHub repositories for your ROM collection." Margin="0,5,0,0" />
            <TextBlock Name="AppVersionTextBlock" Margin="0,10,0,0" Text="" />
            <TextBlock Margin="0,20,0,0" Text="Uses the GitHub API to fetch available systems and cover art." />
            <TextBlock Margin="0,5,0,0" Text="Supports rate limit handling and parallel downloads." />
            <TextBlock Margin="0,10,0,0">
                <Hyperlink NavigateUri="https://www.purelogiccode.com" RequestNavigate="Hyperlink_RequestNavigate">https://www.purelogiccode.com</Hyperlink>
            </TextBlock>
            <TextBlock Margin="0,10,0,0" Text="© 2025 Pure Logic Code. All rights reserved." />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="10" HorizontalAlignment="Center" Orientation="Horizontal">
            <Button Width="100" Margin="10,0,0,0" Click="CloseButton_Click" Content="Close" />
        </StackPanel>
    </Grid>
</Window>
