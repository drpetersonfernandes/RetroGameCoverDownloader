<Window x:Class="RetroGameCoverDownloader.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Retro Game Cover Downloader"
        Width="450"
        Height="450"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ToolTip="About Retro Game Cover Downloader">
    <Grid ToolTip="Application information and credits">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10" HorizontalAlignment="Center" Orientation="Horizontal">
            <Image Width="128" Height="128" Source="pack://application:,,,/images/logo.png"
                   ToolTip="Retro Game Cover Downloader logo"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock FontWeight="Bold" FontSize="18" Text="Retro Game Cover Downloader"
                       ToolTip="Application name"/>
            <TextBlock x:Name="DescriptionTextBlock" TextWrapping="Wrap"
                       Text="A utility for downloading game cover art from libretro-thumbnails GitHub repositories for your ROM collection."
                       Margin="0,5,0,0"
                       ToolTip="Brief description of the application"/>
            <TextBlock Name="AppVersionTextBlock" Margin="0,10,0,0" Text=""
                       ToolTip="Current installed version of the application"/>
            <TextBlock Margin="0,20,0,0" Text="Uses the GitHub API to fetch available systems and cover art."
                       ToolTip="This application connects to GitHub to browse and download cover art"/>
            <TextBlock Margin="0,5,0,0" Text="Supports rate limit handling and parallel downloads."
                       ToolTip="Automatically manages GitHub API rate limits during downloads"/>
            <TextBlock Margin="0,10,0,0">
                <Hyperlink NavigateUri="https://www.purelogiccode.com" RequestNavigate="Hyperlink_RequestNavigate"
                           ToolTip="Opens the developer website in your browser">
                    https://www.purelogiccode.com
                </Hyperlink>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="10" HorizontalAlignment="Center" Orientation="Horizontal">
            <Button Width="100" Margin="10,0,0,0" Click="CloseButton_Click" Content="Close"
                    ToolTip="Close the About window"/>
        </StackPanel>
    </Grid>
</Window>
