<Window x:Class="RetroGameCoverDownloader.Views.TokenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub Token Required" Height="250" Width="420" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Please enter your GitHub Personal Access Token:" Margin="0,0,0,10"/>
        <TextBlock Text="(Leave empty to proceed with limited rate limits)" Foreground="Gray" FontSize="10" Margin="0,0,0,10"/>
        <TextBox x:Name="TokenBox" Height="30" Margin="0,0,0,20"/>
        <Button Content="Save &amp; Continue" Click="Button_Click" Height="30" Width="100" HorizontalAlignment="Right"/>
    </StackPanel>
</Window>