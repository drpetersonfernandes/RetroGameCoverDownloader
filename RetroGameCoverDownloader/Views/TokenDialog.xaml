<ui:FluentWindow x:Class="RetroGameCoverDownloader.Views.TokenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="GitHub Token Setup" Height="520" Width="620"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        ToolTip="Configure a GitHub Personal Access Token for higher rate limits">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="GitHub Token Setup"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" ToolTip="Scroll to see all token setup instructions">
        <StackPanel Margin="20" ToolTip="GitHub token setup form">
            <!-- Title -->
            <TextBlock Text="GitHub Personal Access Token" Style="{StaticResource TitleTextStyle}"
                       ToolTip="Set up authentication for higher GitHub API usage limits"/>
            
            <!-- Key Benefits/Limitations -->
            <TextBlock Text="Why do I need this?" Style="{StaticResource SectionHeadingStyle}"
                       ToolTip="Understanding the benefits of using a token"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                       ToolTip="Comparison of rate limits with and without a token">
                <Run Text="Without a token: " Style="{StaticResource BoldRunStyle}"/>
                <Run Text="55 downloads/hour limit (~50 games)"/>
                <LineBreak/>
                <Run Text="With a token: " Style="{StaticResource BoldRunStyle}"/>
                <Run Text="4,900 downloads/hour (recommended)"/>
            </TextBlock>
            
            <!-- What is it -->
            <TextBlock Text="What is it?" Style="{StaticResource SectionHeadingStyle}"
                       ToolTip="Explanation of what a Personal Access Token is"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                       ToolTip="A token lets GitHub identify you for higher API limits">
                A secure authentication key that GitHub uses to identify you and grant higher usage limits. It's free and easy to create.
            </TextBlock>
            
            <!-- How to get one -->
            <TextBlock Text="How to get one (free):" Style="{StaticResource SectionHeadingStyle}"
                       ToolTip="Step-by-step guide to creating a token"/>
            <TextBlock Margin="0,0,0,10" FontSize="12"
                       ToolTip="Follow these steps to create your GitHub token">
                <Hyperlink NavigateUri="https://github.com/settings/tokens/new" RequestNavigate="Hyperlink_RequestNavigate"
                           ToolTip="Opens the GitHub token creation page in your browser">
                    1. Click here to create a token
                </Hyperlink>
                <LineBreak/>
                <Run Text="2. Select the "/>
                <Run Text="public_repo" Style="{StaticResource BoldRunStyle}"/>
                <Run Text=" scope"/>
                <LineBreak/>
                <Run Text="3. Click 'Generate token' and copy it below"/>
            </TextBlock>
            
            <!-- Existing Token Indicator -->
            <Border x:Name="ExistingTokenPanel" Visibility="Collapsed" 
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" 
                    CornerRadius="4" Padding="10" Margin="0,0,0,10"
                    ToolTip="A token is already saved">
                <StackPanel>
                    <TextBlock Text="Current token:" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                    <TextBlock Text="**************************" FontFamily="Consolas" FontSize="14" 
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Enter a new token below to replace it, or leave empty to keep the current one." 
                               Style="{StaticResource NoteTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Token Input -->
            <TextBlock Text="Token (optional):" Style="{StaticResource FieldLabelStyle}"
                       ToolTip="Paste your GitHub Personal Access Token here"/>
            <PasswordBox x:Name="TokenBox" Margin="0,0,0,20" Style="{StaticResource PasswordInputStyle}"
                      ToolTip="Paste your GitHub token here, or leave empty to proceed with limited rate (55 requests/hour)"/>
            
            <!-- Note -->
            <TextBlock Text="Leave empty to proceed without a token, but expect slower downloads." 
                       Style="{StaticResource NoteTextStyle}"
                       ToolTip="Without a token, downloads will be limited to approximately 55 per hour"/>
            
            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" ToolTip="Dialog action buttons">
                <Button Content="Cancel" Click="CancelButton_Click" Style="{StaticResource DialogButtonStyle}"
                        ToolTip="Close without saving a token (will use limited anonymous rate)"/>
                <Button Content="Save &amp; Continue" Click="SaveButton_Click" Style="{StaticResource DialogButtonStyle}"
                        Width="150" IsDefault="True" Margin="0"
                        ToolTip="Save the token and continue to the application"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</ui:FluentWindow>
