<Window x:Class="RetroGameCoverDownloader.Views.TokenDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub Token Setup" Height="480" Width="620" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Title -->
            <TextBlock Text="GitHub Personal Access Token" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
            
            <!-- Key Benefits/Limitations -->
            <TextBlock Text="Why do I need this?" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                <Run Text="Without a token: " FontWeight="Bold"/>
                <Run Text="55 downloads/hour limit (~50 games)"/>
                <LineBreak/>
                <Run Text="With a token: " FontWeight="Bold"/>
                <Run Text="4,900 downloads/hour (recommended)"/>
            </TextBlock>
            
            <!-- What is it -->
            <TextBlock Text="What is it?" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="A secure authentication key that GitHub uses to identify you and grant higher usage limits. It's free and easy to create." 
                       TextWrapping="Wrap" Margin="0,0,0,10"/>
            
            <!-- How to get one -->
            <TextBlock Text="How to get one (free):" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Margin="0,0,0,10">
                <Hyperlink NavigateUri="https://github.com/settings/tokens/new" RequestNavigate="Hyperlink_RequestNavigate">
                    1. Click here to create a token
                </Hyperlink>
                <LineBreak/>
                <Run Text="2. Select the " FontSize="12"/>
                <Run Text="public_repo" FontWeight="Bold" FontSize="12"/>
                <Run Text=" scope" FontSize="12"/>
                <LineBreak/>
                <Run Text="3. Click 'Generate token' and copy it below" FontSize="12"/>
            </TextBlock>
            
            <!-- Token Input -->
            <TextBlock Text="Token (optional):" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="TokenBox" Height="30" Margin="0,0,0,20"/>
            
            <!-- Note -->
            <TextBlock Text="Leave empty to proceed without a token, but expect slower downloads." 
                       Foreground="Gray" FontStyle="Italic" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15"/>
            
            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="CancelButton_Click" Width="80" Height="30" Margin="0,0,10,0"/>
                <Button Content="Save &amp; Continue" Click="SaveButton_Click" Width="120" Height="30" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
