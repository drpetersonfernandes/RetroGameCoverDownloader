<Application x:Class="RetroGameCoverDownloader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RetroGameCoverDownloader.Converters"
             ShutdownMode="OnMainWindowClose"
             >
    <Application.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- ==================== Color Resources ==================== -->
        <SolidColorBrush x:Key="StatusTextColor" Color="#333333"/>
        <SolidColorBrush x:Key="NoteTextColor" Color="#808080"/>
        <SolidColorBrush x:Key="MenuItemIconForeground" Color="#333333"/>
        <SolidColorBrush x:Key="UpdateBannerBackgroundColor" Color="#D4EDDA"/>
        <SolidColorBrush x:Key="UpdateBannerBorderColor" Color="#28A745"/>
        <SolidColorBrush x:Key="UpdateBannerTextColor" Color="#155724"/>
        <SolidColorBrush x:Key="UpdateBannerLinkColor" Color="#0C5460"/>

        <!-- ==================== Menu Icon Resources ==================== -->

        <Viewbox x:Key="ProxyIcon" x:Shared="False" Width="16" Height="16">
            <Canvas Width="24" Height="24">
                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20"
                         Stroke="{StaticResource MenuItemIconForeground}" StrokeThickness="1.5" Fill="Transparent"/>
                <Ellipse Canvas.Left="6" Canvas.Top="2" Width="12" Height="20"
                         Stroke="{StaticResource MenuItemIconForeground}" StrokeThickness="1" Fill="Transparent"/>
                <Line X1="2" Y1="12" X2="22" Y2="12"
                      Stroke="{StaticResource MenuItemIconForeground}" StrokeThickness="1"/>
                <Line X1="12" Y1="2" X2="12" Y2="22"
                      Stroke="{StaticResource MenuItemIconForeground}" StrokeThickness="1"/>
                <Path Data="M3,16 L6,14 L6,15.5 L9,15.5 L9,16.5 L6,16.5 L6,18 Z"
                      Fill="{StaticResource MenuItemIconForeground}"/>
                <Path Data="M21,8 L18,10 L18,8.5 L15,8.5 L15,7.5 L18,7.5 L18,6 Z"
                      Fill="{StaticResource MenuItemIconForeground}"/>
            </Canvas>
        </Viewbox>

        <Viewbox x:Key="TokenIcon" x:Shared="False" Width="16" Height="16">
            <Canvas Width="24" Height="24">
                <Ellipse Canvas.Left="5" Canvas.Top="5" Width="14" Height="14"
                         Stroke="{StaticResource MenuItemIconForeground}" StrokeThickness="1.5" Fill="Transparent"/>
                <Path Data="M12,3 L12,10 L10,8 L9,10 L12,14 L15,10 L14,8 L12,10"
                      Stroke="{StaticResource MenuItemIconForeground}" StrokeThickness="1.5" Fill="Transparent"/>
                <Line X1="9" Y1="17" X2="15" Y2="17"
                      Stroke="{StaticResource MenuItemIconForeground}" StrokeThickness="1.5"/>
            </Canvas>
        </Viewbox>

        <Viewbox x:Key="FileExtensionsIcon" x:Shared="False" Width="16" Height="16">
            <Canvas Width="24" Height="24">
                <Path Data="M4,2 L18,2 L18,22 L4,22 Z"
                      Stroke="{StaticResource MenuItemIconForeground}" StrokeThickness="1.5" Fill="Transparent"/>
                <Line X1="7" Y1="6" X2="17" Y2="6"
                      Stroke="{StaticResource MenuItemIconForeground}" StrokeThickness="1.5"/>
                <Line X1="7" Y1="10" X2="17" Y2="10"
                      Stroke="{StaticResource MenuItemIconForeground}" StrokeThickness="1.5"/>
                <Line X1="7" Y1="14" X2="13" Y2="14"
                      Stroke="{StaticResource MenuItemIconForeground}" StrokeThickness="1.5"/>
            </Canvas>
        </Viewbox>

        <Viewbox x:Key="UpdateIcon" x:Shared="False" Width="16" Height="16">
            <Canvas Width="24" Height="24">
                <Path Data="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2"
                      Stroke="{StaticResource MenuItemIconForeground}" StrokeThickness="1.5" Fill="Transparent"/>
                <Path Data="M12,7 L12,13 M9,10 L12,7 L15,10"
                      Stroke="{StaticResource MenuItemIconForeground}" StrokeThickness="1.5" Fill="Transparent"/>
                <Line X1="8" Y1="17" X2="16" Y2="17"
                      Stroke="{StaticResource MenuItemIconForeground}" StrokeThickness="1.5"/>
            </Canvas>
        </Viewbox>

        <!-- ==================== Text Styles ==================== -->

        <!-- Title text: dialog/section headings -->
        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Section heading text -->
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Status text: bold label used for status/clock display -->
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource StatusTextColor}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Note/help text: gray italic informational text -->
        <Style x:Key="NoteTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource NoteTextColor}"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Bold inline text: for use on Run elements -->
        <Style x:Key="BoldRunStyle" TargetType="Run">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Log text: monospace text for log display -->
        <Style x:Key="LogTextStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <!-- Banner update notification text -->
        <Style x:Key="BannerTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Banner update notification hyperlink -->
        <Style x:Key="BannerLinkStyle" TargetType="Hyperlink">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Field label: bold label for input fields -->
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- ==================== Button Styles ==================== -->

        <!-- Standard action button -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <!-- Dialog action button (Save, Cancel, Close) -->
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <!-- Browse/folder picker button -->
        <Style x:Key="BrowseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- ==================== Input Styles ==================== -->

        <!-- Text input field -->
        <Style x:Key="TextInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Read-only display field (bound text) -->
        <Style x:Key="ReadOnlyFieldStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>

        <!-- Password input field -->
        <Style x:Key="PasswordInputStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- ==================== Menu Styles ==================== -->

        <!-- Menu item icon sizing -->
        <Style x:Key="MenuItemIconStyle" TargetType="Image">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
        </Style>

        <!-- ==================== About Window Styles ==================== -->

        <!-- Application logo image -->
        <Style x:Key="AppLogoStyle" TargetType="Image">
            <Setter Property="Width" Value="128"/>
            <Setter Property="Height" Value="128"/>
        </Style>

        <!-- Application title text -->
        <Style x:Key="AppTitleStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>

        <!-- Dialog description: wrapped instructional text -->
        <Style x:Key="DialogDescriptionStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- ==================== Additional Button Styles ==================== -->

        <!-- Small action button (e.g., Add) -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="30"/>
        </Style>

    </Application.Resources>
</Application>
