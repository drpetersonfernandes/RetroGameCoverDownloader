<Window x:Class="RetroGameCoverDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:RetroGameCoverDownloader.ViewModels"
        mc:Ignorable="d"
        Title="Retro Game Cover Downloader" Height="600" Width="800">
    
    <Window.DataContext>
        <viewModels:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Inputs -->
            <RowDefinition Height="Auto"/> <!-- System Select -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
            <RowDefinition Height="Auto"/> <!-- Progress -->
            <RowDefinition Height="*"/>    <!-- Log -->
        </Grid.RowDefinitions>

        <!-- 1 & 2: Folder Inputs -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="ROM Folder:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RomFolderPath}" Margin="0,0,10,10" IsReadOnly="True"/>
            <Button Grid.Row="0" Grid.Column="2" Content="Set ROM Folder" Command="{Binding BrowseRomCommand}" Width="120" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cover Folder:" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CoverFolderPath}" Margin="0,0,10,10" IsReadOnly="True"/>
            <Button Grid.Row="1" Grid.Column="2" Content="Set Cover Folder" Command="{Binding BrowseCoverCommand}" Width="120" Margin="0,0,0,10"/>
        </Grid>

        <!-- 3: System Dropdown -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Select System:" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding Systems}" 
                      SelectedItem="{Binding SelectedSystem}"
                      DisplayMemberPath="SystemName"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/> 
            <!-- Note: You need a BooleanInverter converter or just use !IsBusy in ViewModel logic -->
        </StackPanel>

        <!-- 4, 5, 6: Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="Prepare for Download" Command="{Binding PrepareCommand}" Width="150" Height="30" Margin="5"/>
            <Button Content="Download Covers" Command="{Binding DownloadCommand}" Width="150" Height="30" Margin="5"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="100" Height="30" Margin="5"/>
        </StackPanel>

        <!-- Progress Bar Section -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <!-- TextBlock for the Status/Clock -->
            <TextBlock Text="{Binding StatusMessage}" 
                       HorizontalAlignment="Center" 
                       FontWeight="Bold" 
                       Foreground="#333333"
                       Margin="0,0,0,5"/>
            
            <ProgressBar Height="20" 
                         Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"/>
        </StackPanel>

        <!-- Log Window -->
        <GroupBox Grid.Row="4" Header="Log">
            <TextBox Text="{Binding LogText}" 
                     VerticalScrollBarVisibility="Auto" 
                     TextWrapping="Wrap" 
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     TextChanged="TextBox_TextChanged"/>
        </GroupBox>
    </Grid>
</Window>